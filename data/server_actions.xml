            <field name="name">Grupo Núcleo: Sincronizar impuestos venta y compra desde API</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">result = model.browse()._gruponucleo_sync_sale_taxes_from_api()</field>
        </record>
    </data>
</odoo>
