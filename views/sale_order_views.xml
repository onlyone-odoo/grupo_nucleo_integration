<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_gruponucleo" model="ir.ui.view">
        <field name="name">sale.order.form.gruponucleo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="gn_send_on_confirm" invisible="state != 'draft'"/>
                <field name="gn_order_sent" readonly="1"/>
                <field name="gn_order_ref" readonly="1"/>
                <field name="gn_sync_error" readonly="1" invisible="not gn_sync_error"/>
                <field name="purchase_order_id" readonly="1"/>
                <button name="action_view_purchase_order_gn" type="object" string="Ver orden de compra" class="btn-link" invisible="not purchase_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
